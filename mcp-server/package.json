{
  "name": "@knowledge-graph-plugin/mcp-server",
  "version": "0.3.10",
  "description": "MCP server for Knowledge Management Graph — cross-platform data layer for knowledge capture, search, and management",
  "main": "dist/index.js",
  "bin": {
    "knowledge-graph": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/index.js --external:node-sqlite3-wasm \"--define:__SERVER_VERSION__=\\\"0.3.10\\\"\"",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/cli.js --external:node-sqlite3-wasm \"--define:__SERVER_VERSION__=\\\"0.3.10\\\"\"",
    "build:copy-wasm": "node -e \"const fs=require('fs');fs.rmSync('dist/node_modules/node-sqlite3-wasm',{recursive:true,force:true});fs.cpSync('node_modules/node-sqlite3-wasm','dist/node_modules/node-sqlite3-wasm',{recursive:true});console.log('copied node-sqlite3-wasm -> dist/node_modules/')\"",
    "build": "npm run build:bundle && npm run build:cli && npm run build:copy-wasm",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "dev": "tsc --watch",
    "test": "jest"
  },
  "overrides": {
    "handlebars": ">=4.7.9",
    "hono": ">=4.12.23",
    "path-to-regexp": ">=8.4.0",
    "picomatch": ">=2.3.2",
    "fast-uri": ">=3.1.2",
    "ip-address": ">=10.1.1",
    "qs": ">=6.15.2"
  },
  "keywords": [
    "mcp",
    "knowledge-graph",
    "lessons-learned",
    "memory"
  ],
  "author": "technomensch",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "node-sqlite3-wasm": "^0.8.55",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.2.3",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
