{
  "name": "@knowledge-graph-plugin/mcp-server",
  "version": "0.1.2-beta",
  "description": "MCP server for Knowledge Management Graph — cross-platform data layer for knowledge capture, search, and management",
  "main": "dist/index.js",
  "bin": {
    "knowledge-graph": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "dev": "tsc --watch",
    "test": "jest",
    "postinstall": "npm run build"
  },
  "keywords": [
    "mcp",
    "knowledge-graph",
    "lessons-learned",
    "memory"
  ],
  "author": "technomensch",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "node-sqlite3-wasm": "^0.8.55",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^25.2.3",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
