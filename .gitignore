# Local MCP configuration (contains machine-specific paths)
.mcp.json

# macOS system files
.DS_Store
**/.DS_Store
Icon?
**/.SynologyWorkingDirectory/

# Node.js dependencies (MCP server)
node_modules/
mcp-server/node_modules/

# Python bytecode
*.pyc
__pycache__/
*.pyo
*.pyd
.venv/
venv/
env/

# IDE
.vscode/
.idea/
**/.obsidian/
*.swp
*.swo
*~

# Development
.agent
*.log
.env
.env.local
chat-history/
*.backup

# Build artifacts
dist/
!mcp-server/dist/
# Bundled wasm runtime — committed so git-clone installs work without npm install
# Must appear AFTER dist/ and node_modules/ rules (last matching rule wins)
!mcp-server/dist/node_modules/
!mcp-server/dist/node_modules/**
!mcp-server/dist/node_modules/**/dist/
!mcp-server/dist/node_modules/**/dist/**
build/
*.tgz

# Docusaurus cache (generated at build time)
.docusaurus/

# MkDocs generated site
site/

# Knowledge Graph - selective strategy
# Personal debugging notes
docs/lessons-learned/debugging/
knowledge/lessons-learned/debugging/
# Session summaries (always private)
docs/sessions/
knowledge/sessions/*
!knowledge/sessions/session-template.md
# Playwright MCP browser data
.playwright-mcp/
# Chat exports (always private)
docs/chat-history/
knowledge/chat-history/
# Implementation plans (local only)
docs/plans/
knowledge/plans/
# Issue/enhancement-parented plan mirrors (local only, per ADR-029 routing)
knowledge/issues/*/v*.c[0-9]*.md
knowledge/enhancements/*/v*.c[0-9]*.md
# Superpowers docs (local only)
docs/superpowers/
# Specs (local only)
docs/specs/
# Scratch/temp files (always private)
docs/tmp/
knowledge/tmp/
# Personal identity file (always private)
knowledge/me.md
# Note: architecture/ and patterns/ are committed for team sharing

# Note: reference/, examples/, and templates/ are now committed for Docusaurus
.kg-archive-*/

# Superpowers (local only)
.superpowers/

# Handoff packages (local only)
handoff-packages/

# Mintlify preview (local only)
mintlify-preview/

# Git worktrees (local only)
.worktrees/
